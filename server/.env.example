# CraveKart Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
# For Local Zero-Config standalone (SQLite):
DATABASE_URL="file:./dev.db"
# For Docker / Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cravekart?schema=public"

# Authentication
JWT_SECRET=super-secret-cravekart-jwt-key-min-32-chars-long-12345
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cravekart-cookie-key-56789

# Payment Gateway - Razorpay Test Mode
# In development/test mode, built-in mock gateway is used when dummy keys are set
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Email Service (Resend or SMTP)
# Optional in development; when unset, emails/reset tokens are logged to server console
RESEND_API_KEY=
EMAIL_FROM=no-reply@cravekart.com

# Cloudinary (Optional image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
