# ==========================================
# CraveKart - Full-Stack Food Ordering Platform
# Environment Configuration Template
# ==========================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# DATABASE CONFIGURATION
# Local zero-config SQLite:
DATABASE_URL="file:./dev.db"
# Production / Docker PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cravekart?schema=public"

# AUTHENTICATION & SECURITY
JWT_SECRET=super-secret-cravekart-jwt-key-min-32-chars-long-12345
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cravekart-cookie-key-56789

# PAYMENT GATEWAY (RAZORPAY)
# Set your test keys from https://dashboard.razorpay.com/#/access_keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# EMAIL SERVICE (OPTIONAL)
RESEND_API_KEY=
EMAIL_FROM=no-reply@cravekart.com

# IMAGE STORAGE (OPTIONAL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
